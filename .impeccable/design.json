  "narrative": {
    "northStar": "Bronze, stone and cartography",
    "overview": "An everyday community app whose defining canvas is the territorial map. Aged bronze, dark stone, subtle cartographic details and medallion trophies supply the material character; familiar controls and plain Portuguese keep the experience approachable.\n\nThe angular M in a six-sided seal anchors the identity. Subdued cover photography carries living community activity, while bronze-medallion artwork carries the ancient material. Community themes change accent, cover and emblem within a stable navigation and accessibility system.",
    "keyCharacteristics": [
      "Dark stone surfaces with restrained bronze emphasis.",
      "Cartographic ownership reinforced by symbols and names.",
      "Compact Manrope typography and familiar, keyboard-accessible controls.",
      "Local artwork, subdued photography and explicitly identified demonstration content."
    ],
    "rules": [
      {
        "name": "The Readable Accent Rule",
        "body": "Preserve the raw community color in storage and the color editor. Derive visible seals, territorial overlays, dots and community emphasis with `accessibleAccent`: retain colors that reach 4.5:1 against the surface; otherwise blend toward the text color until they do. Invalid input falls back to bronze. Never replace the stored choice with its derived ink.",
        "section": "colors"
      },
      {
        "name": "The Map Readability Rule",
        "body": "Responsive compression must preserve the final 12px essential map labels and 44px map filters; do not restore the earlier compact overrides.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** reserve bronze for meaningful actions, territory progress and emphasis.",
      "**Do** reinforce ownership with names and emblems as well as color.",
      "**Do** preserve raw community accents and derive readable display ink.",
      "**Do** retain 12px essential map metadata, 44px map filters and visible keyboard focus at every width.",
      "**Do** use local artwork, subdued community photography and honest demonstration labels."
    ],
    "donts": [
      "**Don't** introduce panel gradients, glass, glows or decorative icon tiles.",
      "**Don't** trade familiar controls or plain Portuguese for ornamental lore.",
      "**Don't** turn the app canvas into a landing-page hero or decorative KPI grid.",
      "**Don't** squeeze desktop chat columns or the Local pill into narrow layouts."
    ]
  }
}
