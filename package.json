{
  "name": "mannerbund",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src *.json *.md index.html vite.config.ts",
    "format:check": "prettier --check src *.json *.md index.html vite.config.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "maplibre-gl": "^5.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.4",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.8"
  }
}
